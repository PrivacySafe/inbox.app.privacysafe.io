  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "clean:coverage": "rimraf coverage",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "serve": "vite preview",
    "stylelint": "stylelint --config .stylelint.config.cjs 'src/**/*.{vue,scss}'",
    "stylelint:fix": "stylelint --config .stylelint.config.cjs --fix 'src/**/*.{vue,scss}'",
    "linter": "eslint -c eslint.config.js --ext .js,.vue,.ts, src",
    "linter:fix": "eslint -c eslint.config.js --fix --ext .js,.vue,.ts, src",
    "lint": "pnpm run linter && pnpm run stylelint",
    "lint:fix": "pnpm run linter:fix && pnpm run stylelint:fix",
    "test": "pnpm run clean:coverage && jest",
    "test:watch": "pnpm run clean:coverage && jest --watch"
  },
  "dependencies": {
    "@v1nt1248/3nclient-lib": "0.2.64",
    "dayjs": "1.11.19",
    "lodash": "4.17.21",
    "pdfjs-dist": "^5.4.394",
    "pinia": "3.0.4",
    "sanitize-html": "2.17.0",
    "squire-rte": "2.4.1",
    "vue": "3.5.24",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@testing-library/vue": "8.1.0",
    "@types/jasmine": "5.1.13",
    "@types/lodash": "4.17.20",
    "@types/node": "22.19.1",
    "@types/sanitize-html": "^2.16.0",
    "@typescript-eslint/eslint-plugin": "8.47.0",
    "@typescript-eslint/parser": "8.47.0",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/devtools": "8.0.5",
    "@vue/eslint-config-typescript": "14.6.0",
    "@vuedx/typescript-plugin-vue": "^0.7.6",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-vue": "10.5.1",
    "globals": "16.5.0",
    "postcss-html": "1.8.0",
    "prettier": "3.6.2",
    "sass": "1.94.2",
    "stylelint": "16.25.0",
    "stylelint-config-recommended-scss": "16.0.2",
    "stylelint-config-recommended-vue": "1.6.1",
    "stylelint-config-standard": "39.0.1",
    "stylelint-scss": "6.12.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.47.0",
    "vite": "7.2.4",
    "vite-plugin-node-polyfills": "0.24.0",
    "vite-plugin-vue-devtools": "8.0.5",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "3.1.4"
  },
  "packageManager": "pnpm@10.18.3"
}
