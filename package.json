  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "clean:coverage": "rimraf coverage",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "serve": "vite preview",
    "stylelint": "stylelint --config .stylelint.config.cjs 'src/**/*.{vue,scss}'",
    "stylelint:fix": "stylelint --config .stylelint.config.cjs --fix 'src/**/*.{vue,scss}'",
    "linter": "eslint -c eslint.config.js --ext .js,.vue,.ts, src",
    "linter:fix": "eslint -c eslint.config.js --fix --ext .js,.vue,.ts, src",
    "lint": "pnpm run linter && pnpm run stylelint",
    "lint:fix": "pnpm run linter:fix && pnpm run stylelint:fix",
    "test": "pnpm run clean:coverage && jest",
    "test:watch": "pnpm run clean:coverage && jest --watch"
  },
  "dependencies": {
    "@v1nt1248/3nclient-lib": "0.3.27",
    "dayjs": "1.11.21",
    "lodash": "4.18.1",
    "pdfjs-dist": "5.7.284",
    "pinia": "3.0.4",
    "sanitize-html": "2.17.5",
    "squire-rte": "2.4.8",
    "vue": "3.5.38",
    "vue-i18n": "11.4.5",
    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@testing-library/vue": "8.1.0",
    "@types/jasmine": "6.0.0",
    "@types/lodash": "4.17.24",
    "@types/node": "24.13.2",
    "@types/sanitize-html": "2.16.1",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/devtools": "8.1.3",
    "@vue/eslint-config-typescript": "14.8.0",
    "@vuedx/typescript-plugin-vue": "0.7.6",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-vue": "10.9.2",
    "globals": "17.6.0",
    "postcss-html": "1.8.1",
    "prettier": "3.8.4",
    "sass": "1.101.0",
    "stylelint": "17.13.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "stylelint-config-recommended-vue": "1.6.1",
    "stylelint-config-standard": "39.0.1",
    "stylelint-scss": "7.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.1",
    "vite": "8.0.16",
    "vite-plugin-vue-devtools": "^8.1.3",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.5"
  },
  "packageManager": "pnpm@10.32.1"
}
